<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.SignUpPage"
             x:DataType="viewmodels:SignUpPageViewModel"
             BackgroundColor="#99C1E9"
             FlowDirection="LeftToRight">

    <Grid RowDefinitions="*" ColumnDefinitions="*">

        <VerticalStackLayout Grid.Row="0" 
                             Margin="30,20,30,20" 
                             Spacing="8" 
                             VerticalOptions="Center">

            <Label Text="SIGN UP" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                <Entry Placeholder="First Name" Text="{Binding FirstName}" HorizontalTextAlignment="Start"/>
            </Frame>

            <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                <Entry Placeholder="Last Name" Text="{Binding LastName}" HorizontalTextAlignment="Start"/>
            </Frame>

            <VerticalStackLayout>
                <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                    <Entry Placeholder="Email" Keyboard="Email" Text="{Binding UserEmail}" HorizontalTextAlignment="Start"/>
                </Frame>
                <Label Text="{Binding EmailError}" TextColor="Red" FontSize="11" Margin="5,2,0,0" HeightRequest="15"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Password" IsPassword="{Binding EntryAsPassword}" Text="{Binding UserPassword}" HorizontalTextAlignment="Start" Grid.Column="0"/>
                        <ImageButton Source="{Binding PasswordImage}" Command="{Binding TogglePasswordCommand}" BackgroundColor="Transparent" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Grid.Column="1"/>
                    </Grid>
                </Frame>
                <Label Text="{Binding PasswordError}" TextColor="Red" FontSize="11" Margin="5,2,0,0" HeightRequest="15"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                    <Entry Placeholder="Mobile (10 digits)" Keyboard="Numeric" Text="{Binding Mobile}" MaxLength="10" HorizontalTextAlignment="Start"/>
                </Frame>
                <Label Text="{Binding MobileError}" TextColor="Red" FontSize="11" Margin="5,2,0,0" HeightRequest="15"/>
            </VerticalStackLayout>

            <Label Text="Register as:" TextColor="#2C3E50" FontAttributes="Bold" Margin="5,0,0,5" HorizontalOptions="Start" />

            <Frame BackgroundColor="White" CornerRadius="5" Padding="15,2" HasShadow="False" BorderColor="Transparent">
                <Picker Title="Select Account Type" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" HorizontalTextAlignment="Start"/>
            </Frame>

            <Button Text="SIGN UP" 
                    Command="{Binding SignUpCommand}" 
                    HeightRequest="55" 
                    TextColor="White" 
                    CornerRadius="10" 
                    FontAttributes="Bold" 
                    Margin="0,10,0,0">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#E67E22" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#BDC3C7" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <BoxView HeightRequest="1" BackgroundColor="White" HorizontalOptions="Fill" Margin="20,10,20,5"/>

            <Button Text="Already have an account? Sign In" 
                    BackgroundColor="Transparent" 
                    TextColor="White" 
                    FontSize="14" 
                    HorizontalOptions="Center" 
                    Command="{Binding GoToSignInCommand}" />
        </VerticalStackLayout>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="Black" Opacity="0.5">
            <ActivityIndicator IsRunning="True" Color="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Text="Loading..." TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,60,0,0"/>
        </Grid>
    </Grid>
</ContentPage>