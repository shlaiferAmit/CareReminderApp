<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.ChangeProfilePage"
             x:DataType="viewmodels:ChangeProfileViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             FlowDirection="LeftToRight"
             Title="Edit Profile">

    <!-- Grid שמתפרס על כל המסך -->
    <Grid Padding="25,15" RowDefinitions="Auto, Auto, *, Auto">

        <!-- כותרת - צמצמתי מרווחים -->
        <Label Grid.Row="0"
               Text="Edit Profile" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#2C3E50"
               Margin="0,10,0,10"/>

        <!-- תצוגת תמונה - הקטנתי מעט חזרה ל-140 כדי לחסוך מקום -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,10">
            <Grid HeightRequest="140" WidthRequest="140">
                <Frame CornerRadius="70" 
                       HeightRequest="140" 
                       WidthRequest="140" 
                       Padding="0" 
                       IsClippedToBounds="True" 
                       BorderColor="#3498DB"
                       HasShadow="False">
                    <Image Source="{Binding EditableUser.ProfilePictureUrl, TargetNullValue='user_placeholder.png'}" 
                           Aspect="AspectFill" />
                </Frame>

                <ImageButton Source="camera_icon.png"
                             Command="{Binding ChangePhotoCommand}"
                             WidthRequest="46" 
                             HeightRequest="46"
                             Padding="10"
                             BackgroundColor="#3498DB" 
                             CornerRadius="23"
                             VerticalOptions="End" 
                             HorizontalOptions="End" />
            </Grid>
        </VerticalStackLayout>

        <!-- שדות הקלט - Spacing קטן יותר (10 במקום 15) -->
        <VerticalStackLayout Grid.Row="2" Spacing="15" VerticalOptions="Start">

            <VerticalStackLayout Spacing="2">
                <Label Text="Email Address (Locked)" FontSize="13" TextColor="#34495E"/>
                <Frame BackgroundColor="#ECF0F1" BorderColor="#BDC3C7" Padding="12,10" CornerRadius="10" HasShadow="False">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="✉️" VerticalOptions="Center"/>
                        <Label Text="{Binding EditableUser.UserEmail}" TextColor="#7F8C8D" FontSize="14"/>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="First Name" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="First name" Text="{Binding EditableUser.FirstName}" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Last Name" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="Last name" Text="{Binding EditableUser.LastName}" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Phone Number" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="0501234567" Text="{Binding EditableUser.Mobile}" Keyboard="Telephone" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- כפתור שמירה - ממוקם בשורה האחרונה בנפרד -->
        <Button Grid.Row="3"
                Text="SAVE CHANGES"
                BackgroundColor="#3498DB"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="25"
                HeightRequest="55"
                VerticalOptions="End"
                Margin="0,10,0,5"
                Command="{Binding SaveChangesCommand}"/>

    </Grid>
</ContentPage>