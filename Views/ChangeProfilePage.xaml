<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.ChangeProfilePage"
             x:DataType="viewmodels:ChangeProfileViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             FlowDirection="LeftToRight"
             Title="Edit Profile">

    <Grid Padding="25,15" RowDefinitions="Auto, Auto, *, Auto">

        <Label Grid.Row="0"
               Text="Edit Profile" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#2C3E50"
               Margin="0,10,0,10"/>
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,10">
            <Grid HeightRequest="140" WidthRequest="140">

                <Border HeightRequest="140"
        WidthRequest="140"
        HorizontalOptions="Center"
        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="70"/>
                    </Border.StrokeShape>

                    <Image Source="{Binding ProfileImageSource}"
           Aspect="AspectFill" 
           HeightRequest="140"
           WidthRequest="140"
           HorizontalOptions="Center"
           VerticalOptions="Center" />
                </Border>

                <ImageButton Source="camera_icon.png"
                     Command="{Binding ChangePhotoCommand}"
                     WidthRequest="40" 
                     HeightRequest="40"
                     Padding="8"
                     BackgroundColor="#3498DB" 
                     CornerRadius="20"
                     VerticalOptions="End" 
                     HorizontalOptions="End"
                     Margin="0,0,5,5" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="15" VerticalOptions="Start">
            <VerticalStackLayout Spacing="2">
                <Label Text="Email Address (Locked)" FontSize="13" TextColor="#34495E"/>
                <Frame BackgroundColor="#ECF0F1" BorderColor="#BDC3C7" Padding="12,10" CornerRadius="10" HasShadow="False">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="✉️" VerticalOptions="Center"/>
                        <Label Text="{Binding EditableUser.UserEmail}" TextColor="#7F8C8D" FontSize="14"/>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="First Name" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="First name" Text="{Binding EditableUser.FirstName}" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Last Name" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="Last name" Text="{Binding EditableUser.LastName}" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Phone Number" FontSize="13" TextColor="#34495E"/>
                <Frame Padding="5,0" CornerRadius="10" HasShadow="False" BackgroundColor="White" BorderColor="#BDC3C7" HeightRequest="50">
                    <Entry Placeholder="0501234567" Text="{Binding EditableUser.Mobile}" Keyboard="Telephone" VerticalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Button Grid.Row="3"
                Text="SAVE CHANGES"
                BackgroundColor="#3498DB"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="25"
                HeightRequest="55"
                VerticalOptions="End"
                Margin="0,10,0,5"
                Command="{Binding SaveChangesCommand}"/>
    </Grid>
</ContentPage>