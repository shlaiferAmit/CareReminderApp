<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.SignInPage"
             x:DataType="vm:SignInPageViewModel"
             BackgroundColor="#99C1E9"
             FlowDirection="LeftToRight">

    <Grid>

        <ScrollView>

            <VerticalStackLayout Margin="30,50,30,20"
                                 Spacing="15"
                                 HorizontalOptions="Fill">

                <!-- TITLE (CENTER) -->
                <Label Text="SIGN IN"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#2C3E50"
                       HorizontalOptions="Center"/>

                <!-- EMAIL -->
                <Frame BackgroundColor="White"
                       Padding="15,5"
                       HorizontalOptions="Fill">

                    <Entry Text="{Binding UserEmail, Mode=TwoWay}"
                           Placeholder="Email"
                           Keyboard="Email"
                           HorizontalTextAlignment="Start"/>
                </Frame>

                <!-- EMAIL ERROR -->
                <Label Text="{Binding EmailError}"
                       TextColor="Red"
                       FontSize="12"
                       HorizontalOptions="Start"
HorizontalTextAlignment="Start"/>

                <!-- PASSWORD -->
                <!-- PASSWORD -->
                <!-- PASSWORD -->
                <Frame BackgroundColor="White"
       Padding="15,5"
       HorizontalOptions="Fill">

                    <Grid ColumnDefinitions="*,Auto"
      VerticalOptions="Center">

                        <Entry Text="{Binding UserPassword, Mode=TwoWay}"
           IsPassword="{Binding EntryAsPassword}"
           Placeholder="Password"
           HorizontalTextAlignment="Start"
           VerticalOptions="Center"
           Grid.Column="0"/>

                        <ImageButton Source="{Binding PasswordImage}"
                 Command="{Binding ShowPasswordCommand}"
                 BackgroundColor="Transparent"
                 HeightRequest="20"
                 WidthRequest="20"
                 VerticalOptions="Center"
                 Grid.Column="1"/>
                    </Grid>

                </Frame>
                <!-- PASSWORD ERROR -->
                <Label Text="{Binding PasswordError}"
                       TextColor="Red"
                       FontSize="12"
                       HorizontalOptions="Start"
HorizontalTextAlignment="Start"/>

                <!-- REMEMBER ME -->
                <HorizontalStackLayout Spacing="10"
                       HorizontalOptions="Start"
                       VerticalOptions="Center">

                    <Label Text="Remember Me"
                           TextColor="#2C3E50"
                           VerticalOptions="Center"/>

                    <CheckBox IsChecked="{Binding IsRememberMeSelected}"
                              Color="#2C3E50"/>

                </HorizontalStackLayout>

                <!-- LOGIN BUTTON -->
                <Button Text="LOGIN"
        Command="{Binding SignInCommand}"
        HeightRequest="60"
        TextColor="White"
        CornerRadius="10"
        HorizontalOptions="Fill">

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#E67E22" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#BDC3C7" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>

                <BoxView HeightRequest="1" 
           BackgroundColor="White" 
           HorizontalOptions="Fill" 
           Margin="20,10,20,0"/>

                <!-- SIGN UP (CENTER) -->
                <Button Text="Don't have an account? Sign Up"
                        Command="{Binding GoToSignUpCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </ScrollView>

        <!-- LOADING -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="Black"
              Opacity="0.5">

            <ActivityIndicator IsRunning="True"
                               Color="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

        </Grid>

    </Grid>
</ContentPage>