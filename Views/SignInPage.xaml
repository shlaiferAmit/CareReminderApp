<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.SignInPage"
             x:DataType="vm:SignInPageViewModel"
             BackgroundColor="#99C1E9"
             FlowDirection="LeftToRight">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Margin="30,50,30,20" Spacing="20" VerticalOptions="Center">

                <Label Text="SIGN IN" FontSize="32" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center" Margin="0,0,0,20"/>

                <!-- Email Entry -->
                <Frame BackgroundColor="White" CornerRadius="5" Padding="15,5" HasShadow="False" BorderColor="Transparent">
                    <Entry Placeholder="Email"
                           PlaceholderColor="Gray"
                           Keyboard="Email"
                           Text="{Binding UserEmail, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                           TextColor="#333"
                           FontSize="16"/>
                </Frame>

                <!-- Password Entry -->
                <Frame BackgroundColor="White" CornerRadius="5" Padding="15,5" HasShadow="False" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Placeholder="Password"
                               PlaceholderColor="Gray"
                               IsPassword="{Binding EntryAsPassword}"
                               Text="{Binding UserPassword, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                               TextColor="#333"
                               FontSize="16"
                               Grid.Column="0"/>

                        <ImageButton Source="{Binding PasswordImage}"
                                     Command="{Binding ShowPasswordCommand}"
                                     BackgroundColor="Transparent"
                                     HeightRequest="20" WidthRequest="20" VerticalOptions="Center"
                                     Grid.Column="1"/>
                    </Grid>
                </Frame>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,5">
                    <CheckBox IsChecked="{Binding IsRememberMeSelected}" Color="#2C3E50" />
                    <Label Text="Remember Me" VerticalOptions="Center" TextColor="#2C3E50" FontSize="16" />
                </HorizontalStackLayout>

                <!-- LOGIN Button -->
                <Button Text="LOGIN" 
                        Command="{Binding SignInCommand}" 
                        TextColor="White" 
                        HeightRequest="60" 
                        CornerRadius="5" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- צבע ברירת המחדל (כתום - כשפעיל) -->
                            <Setter Property="BackgroundColor" Value="#E67E22" />
                            <Style.Triggers>
                                <!-- כשחסר מידע והכפתור מושבת, הוא יהיה אפור -->
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="BackgroundColor" Value="#BDC3C7" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <BoxView HeightRequest="1" BackgroundColor="White" HorizontalOptions="FillAndExpand" Margin="20,10"/>
                <Button Text="Don't have an account? Sign Up" Command="{Binding GoToSignUpCommand}" BackgroundColor="Transparent" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="Black" Opacity="0.5">
            <ActivityIndicator IsRunning="True" Color="White" WidthRequest="100" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>