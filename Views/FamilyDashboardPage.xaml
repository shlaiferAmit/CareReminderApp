<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             xmlns:models="clr-namespace:CareReminderApp.Models"
             x:Class="CareReminderApp.Views.FamilyDashboardPage"
             x:DataType="viewmodels:FamilyDashboardViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,10,0,25">
            <Image Source="logo.png" 
                   HeightRequest="90" 
                   HorizontalOptions="Center"/>
            <Label Text="CareRemind" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Border BackgroundColor="#1ABC9C" 
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    StrokeThickness="0">
                <Label Text="{Binding WelcomeMessage}" 
                       TextColor="White" 
                       FontSize="20" 
                       HeightRequest="40"
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"/>
            </Border>

            <Button Text="+ Add New Senior" 
                    BackgroundColor="#2C3E50" 
                    TextColor="White" 
                    CornerRadius="15" 
                    FontSize="20" 
                    HeightRequest="75" 
                    FontAttributes="Bold"
                    Command="{Binding AddSeniorCommand}"/>

            <Label Text="My Seniors:" 
                   TextColor="#2C3E50" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="End"
                   Margin="0,15,5,5"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Elders}"
                        SelectionMode="None"
                        HorizontalOptions="Fill"
                        Margin="0,5,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0"
                            Padding="12"
                            Margin="0,5"
                            HorizontalOptions="Fill">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FamilyDashboardViewModel}}, Path=GoToProfileCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="15">

                            <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="#ECF0F1">
                                <Image Source="{Binding ProfilePictureUrl}" Aspect="AspectFill" HeightRequest="50" WidthRequest="50" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding FirstName}" FontSize="17" FontAttributes="Bold" TextColor="#2C3E50" HorizontalTextAlignment="Start"/>
                                <Label Text="Connected" FontSize="12" TextColor="#7F8C8D" HorizontalTextAlignment="Start"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="Remove"
                                    BackgroundColor="Gray"
                                    TextColor="White"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="35"
                                    WidthRequest="80"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FamilyDashboardViewModel}}, Path=RemoveConnectionCommand}"
                                    CommandParameter="{Binding .}" />

                            <Label Grid.Column="3" 
                                   Text="‹" 
                                   FontSize="24" 
                                   TextColor="#BDC3C7" 
                                   VerticalOptions="Center" 
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="No seniors connected yet."
                       TextColor="#2C3E50"
                       HorizontalOptions="End"
                       Margin="15,40"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>