<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             xmlns:models="clr-namespace:CareReminderApp.Models"
             x:Class="CareReminderApp.Views.FamilyDashboardPage"
             x:DataType="viewmodels:FamilyDashboardViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             FlowDirection="LeftToRight">
    <!-- הגדרה שכל הדף ייקרא משמאל לימין -->

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,10,0,25">
            <Image Source="logo.png" 
                   HeightRequest="90" 
                   HorizontalOptions="Center"/>
            <Label Text="CareRemind" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Welcome & Add Button -->
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Border BackgroundColor="#1ABC9C" 
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    StrokeThickness="0">
                <Label Text="{Binding WelcomeMessage}" 
                       TextColor="White" 
                       FontSize="20" 
                       HeightRequest="40"
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"/>
            </Border>

            <Button Text="+ Add New Senior" 
                    BackgroundColor="#2C3E50" 
                    TextColor="White" 
                    CornerRadius="15" 
                    FontSize="20" 
                    HeightRequest="75" 
                    FontAttributes="Bold"
                    Command="{Binding AddSeniorCommand}"/>

            <!-- כותרת מיושרת לשמאל -->
            <Label Text="My Seniors:" 
                   TextColor="#2C3E50" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Start"
                   Margin="5,15,0,5"/>
        </VerticalStackLayout>

        <!-- Elders List -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadEldersCommand}"
                     Margin="0,5,0,0">

            <!-- CollectionView עם יישור מוחלט לשמאל -->
            <CollectionView ItemsSource="{Binding Elders}"
                            SelectionMode="None"
                            HorizontalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                Padding="12"
                                Margin="0,5"
                                HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FamilyDashboardViewModel}}, Path=GoToProfileCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <!-- הגדרת עמודות משמאל לימין -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <!-- תמונה/אות משמאל -->
                                <Border Grid.Column="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    StrokeShape="RoundRectangle 25"
                                    StrokeThickness="0"
                                    BackgroundColor="#ECF0F1">
                                    <!-- הסרנו את IsClippedToBounds מכאן -->

                                    <Image Source="{Binding ProfilePictureUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="50"
                                       WidthRequest="50" />
                                </Border>
                                <!-- טקסט במרכז/שמאל -->
                                <VerticalStackLayout Grid.Column="1" 
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="Start">
                                    <Label Text="{Binding FirstName}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"
                                           HorizontalTextAlignment="Start"/>
                                    <Label Text="Connected" 
                                           FontSize="12" 
                                           TextColor="#7F8C8D"
                                           HorizontalTextAlignment="Start"/>
                                </VerticalStackLayout>

                                <!-- חץ ניווט בימין -->
                                <Label Grid.Column="2" 
                                       Text="›" 
                                       FontSize="24" 
                                       TextColor="#BDC3C7" 
                                       VerticalOptions="Center" 
                                       Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No seniors connected yet."
                           TextColor="#2C3E50"
                           HorizontalOptions="Start"
                           Margin="15,40"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>