<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             FlowDirection="LeftToRight">

    <!-- שימוש ב-Grid עם שורות קבועות ללא ScrollView -->
    <Grid RowDefinitions="Auto, *">

        <!-- כותרת העמוד -->
        <Label Grid.Row="0" 
               Text="My Profile" 
               FontSize="32" 
               FontAttributes="Bold"
               HorizontalOptions="Center" 
               TextColor="#2C3E50" 
               Margin="0,20,0,10"/>

        <!-- תוכן הפרופיל בתוך Frame קבוע -->
        <Frame Grid.Row="1"
               BackgroundColor="White" 
               Margin="25,10,25,30" 
               Padding="20" 
               CornerRadius="15" 
               HasShadow="True"
               VerticalOptions="FillAndExpand">

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- 1. תמונת פרופיל -->
                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,5,0,20">
                    <Frame CornerRadius="80"
                           HeightRequest="160"
                           WidthRequest="160"
                           Padding="0"
                           IsClippedToBounds="True"
                           HasShadow="False"
                           BorderColor="#3498DB">
                        <Image Source="{Binding ProfileImageSource}"
                               Aspect="AspectFill" />
                    </Frame>
                </VerticalStackLayout>

                <!-- 2. פרטי המשתמש - תופסים את מרכז המסך -->
                <VerticalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Center">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Full Name" FontSize="12" TextColor="#7F8C8D" 
                               FontAttributes="Bold" HorizontalTextAlignment="Start"/>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding DisplayUser.FirstName}" FontSize="18" TextColor="#2C3E50"/>
                            <Label Text="{Binding DisplayUser.LastName}" FontSize="18" TextColor="#2C3E50"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#ECF0F1"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Email Address" FontSize="12" TextColor="#7F8C8D" 
                               FontAttributes="Bold" HorizontalTextAlignment="Start"/>
                        <Label Text="{Binding DisplayUser.UserEmail}" FontSize="16" 
                               TextColor="#2C3E50" HorizontalTextAlignment="Start"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#ECF0F1"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Phone Number" FontSize="12" TextColor="#7F8C8D" 
                               FontAttributes="Bold" HorizontalTextAlignment="Start"/>
                        <Label Text="{Binding DisplayUser.Mobile}" FontSize="16" 
                               TextColor="#2C3E50" HorizontalTextAlignment="Start"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- 3. כפתור עריכה תמיד בתחתית ה-Frame -->
                <Button Grid.Row="2"
                        Text="EDIT PROFILE" 
                        Command="{Binding EditProfileCommand}"
                        BackgroundColor="#3498DB" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="25" 
                        HeightRequest="55"
                        Margin="0,20,0,0"
                        VerticalOptions="End"/>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>