<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:CareReminderApp.ViewModels"
             x:Class="CareReminderApp.Views.AddReminderPage"
             x:DataType="viewmodels:AddReminderViewModel"
             BackgroundColor="#99C1E9"
             Shell.NavBarIsVisible="True"
             Title="Add Reminder"
             FlowDirection="LeftToRight">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" 
          Padding="30" 
          RowSpacing="15">

        <!-- Title Header -->
        <Label Grid.Row="0"
               Text="{Binding SelectedElder.FirstName, StringFormat='New Reminder for {0}'}" 
               FontSize="26" 
               FontAttributes="Bold" 
               TextColor="#2C3E50" 
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center"
               Margin="0,0,0,10"/>

        <!-- Reminder Title Input -->
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Reminder Title" TextColor="#2C3E50" FontAttributes="Bold" />
            <Frame BackgroundColor="White" CornerRadius="10" Padding="5,0" HasShadow="False">
                <Entry Placeholder="Enter title here..." 
                       Text="{Binding ReminderTitle, Mode=TwoWay}" 
                       HeightRequest="55" 
                       TextColor="Black"/>
            </Frame>
        </VerticalStackLayout>

        <!-- Date Selection -->
        <VerticalStackLayout Grid.Row="2" Spacing="5">
            <Label Text="Select Date" TextColor="#2C3E50" FontAttributes="Bold" />
            <Frame BackgroundColor="White" CornerRadius="10" Padding="5,0" HasShadow="False">
                <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}" 
                            MinimumDate="{x:Static System:DateTime.Now}"
                            HeightRequest="55" 
                            TextColor="Black"/>
            </Frame>
        </VerticalStackLayout>

        <!-- Time Selection -->
        <VerticalStackLayout Grid.Row="3" Spacing="5">
            <Label Text="Select Time" TextColor="#2C3E50" FontAttributes="Bold" />
            <Frame BackgroundColor="White" CornerRadius="10" Padding="5,0" HasShadow="False">
                <TimePicker Time="{Binding SelectedTime, Mode=TwoWay}" 
                            HeightRequest="55" 
                            TextColor="Black"/>
            </Frame>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="4" Spacing="5">
            <Label Text="Additional Notes" TextColor="#2C3E50" FontAttributes="Bold" />
            <Frame BackgroundColor="White" CornerRadius="10" Padding="10" HasShadow="False">
                <Editor Placeholder="Add details or instructions..." 
                        Text="{Binding Notes, Mode=TwoWay}" 
                        HeightRequest="80" 
                        TextColor="Black"
                        AutoSize="Disabled"/>
            </Frame>
        </VerticalStackLayout>

        <Button Grid.Row="5"
                Text="Save and Send Reminder" 
                Command="{Binding SaveAndSendReminderCommand}"
                BackgroundColor="#1ABC9C" 
                TextColor="White" 
                FontAttributes="Bold"
                CornerRadius="30" 
                HeightRequest="60"
                VerticalOptions="End"
                Margin="0,10,0,0"/>

    </Grid>
</ContentPage>